# LinkedIn OAuth Credentials
# Create your app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here

# Brave Search (for AI trend reports)
# Get API key at: https://api.search.brave.com/
BRAVE_API_KEY=your_brave_api_key_here

# Slack (for team reports)
# Create bot at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_TEAM_ID=T0XXXXXXXX
SLACK_REPORT_CHANNEL=#linkedin-reports
